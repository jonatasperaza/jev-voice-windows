# Chave da API do Jev (TypeSafe AI) - obtida no early access
TYPESAFE_API_KEY=coloque_sua_chave_aqui

# Idioma do reconhecimento de voz (faster-whisper). Codigo ISO curto
# tambem funciona (ex: pt).
SPEECH_LANGUAGE=pt-BR

# Tempo maximo (segundos) que o reconhecedor escuta antes de desistir.
SPEECH_MAX_SECONDS=12

# Silencio (segundos) antes de comecar a falar para desistir (evita
# ficar escutando pra sempre se ninguem falar).
SPEECH_INITIAL_SILENCE_SECONDS=6

# Silencio (segundos) apos a fala para considerar que a frase terminou
# (menor = responde mais rapido, mas pode cortar frases com pausas).
SPEECH_END_SILENCE_SECONDS=1.2

# Caminho do executavel Python usado pelo worker de voz (faster-whisper).
# Se voce criou o venv em python/.venv (recomendado), aponte pra ele:
# WHISPER_PYTHON=python/.venv/Scripts/python.exe
WHISPER_PYTHON=python

# Hotkey global de push-to-talk (formato Electron Accelerator).
# Um unico toque comeca a ouvir; o Windows detecta sozinho o fim da fala.
PUSH_TO_TALK_HOTKEY=Control+Space

# Timeout (ms) das chamadas a API do Jev.
JEV_TIMEOUT_MS=15000
